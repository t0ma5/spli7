{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "spl1t",
  "compatibility_date": "2026-08-10",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "spl1t",
    },
  ],
  "d1_databases": [
    {
      "binding": "DATABASE",
      "database_name": "spl1t",
      "database_id": "41a44c89-54ce-4761-887a-9a1e6408403c",
      "migrations_dir": "migrations",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "DB",
      "id": "94eaadc98e2246d7989b734acf2cb461",
      "preview_id": "94eaadc98e2246d7989b734acf2cb461",
    },
  ],
  "vars": {
    "NEXT_PUBLIC_BASE_URL": "https://spl1t.pages.dev",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
