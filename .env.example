NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_CURRENCY_CODE=

# Opt-in features below depended on S3 / OpenAI in upstream Spliit.
# They are disabled on this Cloudflare D1 deploy — keep unset/false.
# NEXT_PUBLIC_ENABLE_EXPENSE_DOCUMENTS=false
# NEXT_PUBLIC_ENABLE_RECEIPT_EXTRACT=false
# NEXT_PUBLIC_ENABLE_CATEGORY_EXTRACT=false

# Required in production for PIN cookies (HMAC). 32+ random bytes.
# PIN_SECRET=

# Bearer token for /api/cron/* (cleanup, backup, recurring, migrate-kv)
# CRON_SECRET=
