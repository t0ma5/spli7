NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_CURRENCY_CODE=

# Turso (required for app + npm run db:migrate:*).
# TURSO_DATABASE_URL=libsql://spli7-....turso.io
# TURSO_AUTH_TOKEN=

# Receipt photos + daily backups: a PRIVATE Vercel Blob store.
#   npx vercel blob create-store spli7-private --access private
# NEXT_PUBLIC_ENABLE_EXPENSE_DOCUMENTS=true
# BLOB_READ_WRITE_TOKEN=

# AI features from upstream Spliit (OpenAI). The app refuses to start if set.
# NEXT_PUBLIC_ENABLE_RECEIPT_EXTRACT=false
# NEXT_PUBLIC_ENABLE_CATEGORY_EXTRACT=false

# Test database (npm run testdb): Turso Platform API token + org slug.
# TURSO_PLATFORM_TOKEN=
# TURSO_ORG=

# Required in production for PIN cookies (HMAC). 32+ random bytes.
# PIN_SECRET=

# Bearer token for /api/cron/* (cleanup, backup, recurring).
# Vercel Cron also sends this when CRON_SECRET is set.
# CRON_SECRET=
